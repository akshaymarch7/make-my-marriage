# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/make-my-marriage
MONGODB_DB_NAME=make-my-marriage

# Authentication and sessions
SESSION_COOKIE_NAME=mmm_session
AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Make My Marriage <no-reply@example.com>

# Google Places
GOOGLE_PLACES_API_KEY=

# Internal cron
CRON_SECRET=replace-with-at-least-32-random-characters
